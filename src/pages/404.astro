---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import DemoEmbed from "../components/DemoEmbed.astro";
import { game } from "../data/lab";
import { path, useTranslations } from "../i18n";

const t = useTranslations("pt");
const en = useTranslations("en");
---

<BaseLayout lang="pt" title={t("404.title")} alternate={path("home", "en")} noindex>
  <div class="container-prose flex flex-col justify-center py-20">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">{t("404.title")}</h1>
    <p class="mt-4 text-muted">{t("404.text")}</p>
    <p class="mt-1 text-subtle">{en("404.text")}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={path("home", "pt")} class="btn-primary"><Icon name="arrow-left" />{t("404.back")}</a>
      <a href={path("home", "en")} class="btn-ghost">{en("404.back")}</a>
    </div>

    <section class="mt-16">
      <p class="label mb-4">{t("404.game")}</p>
      <DemoEmbed lang="pt" demo={game} />
    </section>
  </div>
</BaseLayout>
