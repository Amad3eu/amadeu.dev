---
/**
 * Demo embutida por iframe. Mostra só uma capa; o iframe (e qualquer som)
 * carrega depois do clique, para não pesar nem tocar nada sozinho.
 */
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import type { Demo } from "../data/lab";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  demo: Demo;
}

const { lang, demo } = Astro.props;
const t = useTranslations(lang);
---

<div class="card overflow-hidden">
  <div class="relative aspect-[4/3] sm:aspect-video" data-demo data-src={demo.url} data-title={demo.title}>
    <Image src={demo.poster} alt="" width={1280} class="h-full w-full object-cover" loading="lazy" />
    <div class="absolute inset-0 grid place-items-center bg-bg/50">
      <button type="button" class="btn-primary px-6 py-3 text-base shadow-lg" data-demo-play>
        <span aria-hidden="true">▶</span>
        {t(demo.action === "play" ? "lab.demo.play" : "lab.demo.run")}
      </button>
    </div>
  </div>
  <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border p-4">
    <p class="text-sm text-muted">{t(demo.sound ? "lab.demo.noteSound" : "lab.demo.note")}</p>
    <div class="flex gap-4 font-mono text-xs">
      <a href={demo.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-muted hover:text-fg">
        <Icon name="arrow-up-right" size={14} />
        {t("lab.demo.open")}
      </a>
      <a href={demo.repo} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-muted hover:text-fg">
        <Icon name="github" size={14} />
        {t("projects.code")}
      </a>
    </div>
  </div>
</div>

<script>
  for (const slot of document.querySelectorAll<HTMLElement>("[data-demo]")) {
    slot.querySelector("[data-demo-play]")?.addEventListener("click", () => {
      const frame = document.createElement("iframe");
      frame.src = slot.dataset.src!;
      frame.title = slot.dataset.title!;
      frame.className = "h-full w-full border-0";
      frame.allow = "autoplay; fullscreen";
      frame.setAttribute("sandbox", "allow-scripts allow-same-origin allow-forms allow-popups");
      slot.replaceChildren(frame);
      frame.focus();
    });
  }
</script>
