---
import Icon from "./Icon.astro";
import { site } from "../config/site";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contato" class="container-page mt-24">
  <div class="card relative overflow-hidden px-6 py-12 sm:px-12 sm:py-16">
    <div
      class="pointer-events-none absolute -top-24 -right-24 size-72 rounded-full bg-accent/10 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <p class="eyebrow">{t("contact.eyebrow")}</p>
    <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
      {t("contact.title")}
    </h2>
    <p class="mt-4 max-w-xl leading-relaxed text-muted">{t("contact.text")}</p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href={`mailto:${site.email}`} class="btn-primary">
        <Icon name="mail" />
        {site.email}
      </a>
      <button
        type="button"
        class="btn-ghost"
        data-copy={site.email}
        data-copied-label={t("contact.copied")}
      >
        <Icon name="copy" />
        <span data-copy-label>{t("contact.copy")}</span>
      </button>
      <a href={site.socials.linkedin} class="btn-ghost" target="_blank" rel="noopener">
        <Icon name="linkedin" />
        LinkedIn
      </a>
    </div>
  </div>
</section>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    btn.addEventListener("click", async () => {
      const label = btn.querySelector("[data-copy-label]")!;
      const original = label.textContent;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        label.textContent = btn.dataset.copiedLabel ?? "";
        setTimeout(() => (label.textContent = original), 2000);
      } catch {
        location.href = `mailto:${btn.dataset.copy}`;
      }
    });
  }
</script>
