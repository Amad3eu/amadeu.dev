---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import DoomFire from "../components/DoomFire.astro";
import DemoEmbed from "../components/DemoEmbed.astro";
import Icon from "../components/Icon.astro";
import { demos, fire, game } from "../data/lab";
import { l, otherLang, path, useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={t("lab.title")}
  description={t("lab.description")}
  active="lab"
  alternate={path("lab", otherLang(lang))}
>
  <div class="container-page pt-14 sm:pt-20">
    <header class="mb-16 max-w-2xl">
      <p class="eyebrow">/{t("nav.lab")}</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">{t("lab.title")}</h1>
      <p class="mt-4 leading-relaxed text-muted">{t("lab.description")}</p>
    </header>

    <section class="mb-24">
      <SectionHeading title={l(lang, fire.title)} hint={fire.meta} />
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-12">
        <DoomFire lang={lang} />
        <div>
          <p class="leading-relaxed text-pretty text-muted">{l(lang, fire.text)}</p>
          <h3 class="label mt-8 mb-4">{t("lab.how")}</h3>
          <ol class="space-y-3 text-muted">
            {
              l(lang, fire.how).map((item, i) => (
                <li class="flex gap-3 leading-relaxed">
                  <span class="font-mono text-xs text-accent tabular-nums pt-1">{String(i + 1).padStart(2, "0")}</span>
                  {item}
                </li>
              ))
            }
          </ol>
          <div class="mt-8 flex flex-wrap gap-4 font-mono text-xs">
            <a href={fire.repo} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-muted hover:text-fg">
              <Icon name="github" size={14} />
              {t("projects.code")}
            </a>
            <a href={fire.reference} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-muted hover:text-fg">
              <Icon name="arrow-up-right" size={14} />
              Fabien Sanglard: Doom fire
            </a>
          </div>
        </div>
      </div>
    </section>

    {
      [game, ...demos].map((demo) => (
        <section class="mb-24 last:mb-0">
          <SectionHeading title={demo.title} hint={demo.meta} />
          <div class="grid gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:gap-12">
            <DemoEmbed lang={lang} demo={demo} />
            <div>
              <p class="leading-relaxed text-pretty text-muted">{l(lang, demo.text)}</p>
              <h3 class="label mt-8 mb-4">{t(demo.action === "play" ? "lab.controls" : "lab.howToUse")}</h3>
              <ul class="space-y-2 text-muted">
                {l(lang, demo.tips).map((item) => (
                  <li class="relative pl-5 leading-relaxed before:absolute before:top-[0.7em] before:left-0 before:h-px before:w-2.5 before:bg-border-strong">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
